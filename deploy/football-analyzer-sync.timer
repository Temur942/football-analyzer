# =============================================================================
# football-analyzer — таймер сбора расписания.
#
# Раз в час. Проход по 20 соревнованиям — это ~86 запросов; каждые 15 минут
# получалось ~340 запросов в час, а источник уже показывал троттлинг
# (AGENTS.md §6). Матчи известны на дни вперёд, для окна «за 5 часов» часа
# более чем достаточно.
#
# Включение:
#   systemctl daemon-reload
#   systemctl enable --now football-analyzer-sync.timer
# Состояние:
#   systemctl list-timers football-analyzer-sync.timer
# =============================================================================

[Unit]
Description=football-analyzer: сбор расписания раз в час

[Timer]
OnBootSec=2min
OnUnitActiveSec=1h
AccuracySec=30s
Unit=football-analyzer-sync.service

[Install]
WantedBy=timers.target
