# =============================================================================
# football-analyzer — таймер резервного копирования базы.
#
# Ежедневно в 03:30 UTC (06:30 по Екатеринбургу) — ночью, когда никто ничего
# не пишет. Persistent=true: если сервер был выключен в это время,
# копия будет снята при следующем включении, а не пропущена.
# =============================================================================

[Unit]
Description=football-analyzer: ежедневный бэкап базы

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
Persistent=true
AccuracySec=5min
Unit=football-db-backup.service

[Install]
WantedBy=timers.target
