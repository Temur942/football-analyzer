# =============================================================================
# football-analyzer — шаблон переменных окружения.
# Скопировать в .env.local и заполнить. .env.local в git НЕ попадает.
# Секретов в этом файле быть не должно.
# =============================================================================

# --- Окружение: local | stage | prod -----------------------------------------
APP_ENV=local

# --- Telegram ----------------------------------------------------------------
# Токен от @BotFather. Пустое значение = бот не стартует (защита от пустого
# конфига на проде).
BOT_TOKEN=
# ID администраторов через запятую: 111111111,222222222
# Админы пользуются ботом бесплатно и всегда.
BOT_ADMIN_IDS=
# Закрытая бета: true — пускаем только админов и подписчиков.
CLOSED_BETA=true
# Канал публикаций: @username или числовой id приватного канала (-100...).
# Пусто — автопубликация выключена.
CHANNEL_ID=

# --- База данных -------------------------------------------------------------
# PostgreSQL. Для локальных экспериментов нужен запущенный сервер;
# на стейдже значение приходит из /etc/football-analyzer/stage.env.
DATABASE_URL=postgresql://football:ПАРОЛЬ@127.0.0.1:5432/football?sslmode=disable

# --- Расписание и прогнозы ---------------------------------------------------
# За сколько часов до матча отправляем прогноз.
FORECAST_LEAD_HOURS=5
# Как часто планировщик проверяет расписание, секунды.
SCHEDULER_TICK_SECONDS=60

# --- Внешние источники (бесплатные) -----------------------------------------
# Погода: Open-Meteo — ключ не нужен.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
# Таймаут запросов к внешним API, секунды.
HTTP_TIMEOUT_SECONDS=15

# --- Логи --------------------------------------------------------------------
LOG_LEVEL=INFO
# Кэш soccerdata (на сервере — внутри var проекта).
SOCCERDATA_DIR=var/soccerdata

# --- Учёт расходов (scripts/cost_guard.py) -----------------------------------
COST_PRICES=config/prices.json
COST_LEDGER=var/cost-ledger.sqlite3
BUDGET_MAX_PER_RUN_RUB=0
BUDGET_MAX_PER_DAY_RUB=0

# --- ЮKassa: подписка --------------------------------------------------------
# shopId и секретный ключ из личного кабинета ЮKassa.
# СЕКРЕТ: только этот файл / env-файл сервера, в git не коммитить.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть пользователя после оплаты. Telegram сам откроет бота.
YOOKASSA_RETURN_URL=https://t.me/footballizator_bot

# --- Подписка ----------------------------------------------------------------
# Цена и срок в календарных днях.
SUBSCRIPTION_PRICE_RUB=499
SUBSCRIPTION_DAYS=30

# --- Рассылка ----------------------------------------------------------------
# true — считаем и пишем в журнал, но не отправляем (нужно, пока нет
# доступа к Telegram). false — реальная отправка.
DELIVERY_DRY_RUN=true
