# =============================================================================
# football-analyzer — шаблон переменных окружения.
# Скопировать в .env.local и заполнить. .env.local в git НЕ попадает.
# Секретов в этом файле быть не должно.
# =============================================================================

# --- Окружение: local | stage | prod -----------------------------------------
APP_ENV=local

# --- Telegram ----------------------------------------------------------------
# Токен от @BotFather. Пустое значение = бот не стартует (защита от пустого
# конфига на проде).
BOT_TOKEN=
# ID администраторов через запятую: 111111111,222222222
BOT_ADMIN_IDS=

# --- База данных -------------------------------------------------------------
# PostgreSQL на сервере. Пароль в DSN — секрет: только .env.local / EnvironmentFile.
DATABASE_URL=postgresql://football:ПАРОЛЬ@127.0.0.1:5432/football

# --- Расписание и прогнозы ---------------------------------------------------
# За сколько часов до матча отправляем прогноз.
FORECAST_LEAD_HOURS=5
# Как часто планировщик проверяет расписание, секунды.
SCHEDULER_TICK_SECONDS=60

# --- Внешние источники (бесплатные) -----------------------------------------
# Погода: по умолчанию Open-Meteo — ключ не нужен. Если выбран другой сервис,
# впишите ключ здесь.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
# Таймаут запросов к внешним API, секунды.
HTTP_TIMEOUT_SECONDS=15

# --- Логи --------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Учёт расходов (scripts/cost_guard.py) -----------------------------------
COST_PRICES=config/prices.json
COST_LEDGER=var/cost-ledger.sqlite3
# Потолок на один запуск платной операции, рублей. 0 = платное запрещено.
BUDGET_MAX_PER_RUN_RUB=0
# Потолок на сутки, рублей. 0 = платное запрещено.
BUDGET_MAX_PER_DAY_RUB=0
